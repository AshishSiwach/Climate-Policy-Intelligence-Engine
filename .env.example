# --- LLM providers ---
ANTHROPIC_API_KEY=your_anthropic_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# --- Postgres (Week 5 Step 4a — monitoring stack) ---
# These are picked up by docker-compose.yml AND src/monitoring/db.py.
# Values below are safe for local dev only. Never reuse in a public deploy.
POSTGRES_USER=cpie
POSTGRES_PASSWORD=cpie_dev_only
POSTGRES_DB=cpie
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Host-side port to expose the container on (must match POSTGRES_PORT for the
# same-machine dev flow). Override if 5432 is already taken locally.
POSTGRES_HOST_PORT=5432

# --- Grafana (Week 5 Step 4c) ---
# Local-dev defaults. Grafana forces a password change on first UI login,
# so `admin/admin` is only the initial credential.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
GRAFANA_HOST_PORT=3000

# --- Agent route feature flag (Phase 3) ---
# Controls whether the cross-doc agent path is active.
#   false  — shadow mode: agent runs silently and logs traces; fast-path
#            answer is returned to the user (safe default).
#   canary — agent is active for 10% of cross_doc queries (random sampling).
#   true   — agent is active for all cross_doc queries.
# Restart the app after changing (Streamlit does not hot-reload env vars).
AGENT_ROUTE_ENABLED=false
